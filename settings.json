{
  "lsp": {
    "clangd": {
      "initialization_options": {
        "fallbackFlags": [
          "-I/usr/local/include",
          "-I/usr/local/include/standardloop",
          "-L/usr/local/lib",
          "-L/usr/local/lib/standardloop"
        ]
      }
    }
  },
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{path}"]
        }
      }
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{path}"]
        }
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{path}"]
        }
      }
    }
  },
  "disable_ai": true,
  "buffer_font_features": {
    "calt": false
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "edit_predictions": {
    "provider": "none"
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "terminal_init_command": "",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "theme": "VSCode Dark Modern",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "Cascadia Code",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  }
}
